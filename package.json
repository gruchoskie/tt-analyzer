{
  "name": "tt-analyzer",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "e2e:tracking": "node e2e/gen-ball-y4m.mjs e2e/bola.y4m && BALL_Y4M=e2e/bola.y4m node e2e/tracking.mjs",
    "e2e:selective": "node e2e/gen-ball-y4m.mjs e2e/bola-dist.y4m 6 --distracoes && BALL_Y4M=e2e/bola-dist.y4m node e2e/selective.mjs",
    "e2e:multicam": "node e2e/multicam.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "idb": "^8.0.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "description": "PWA para analisar jogos de t\u00eanis de mesa pela c\u00e2mera do celular, tudo no navegador."
}
